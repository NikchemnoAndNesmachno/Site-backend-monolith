<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="020-create-media-bundles" author="Lain (Ivan)">
        <createTable tableName="media_bundles" schemaName="media">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="owner_user_id" type="BIGINT"/>

            <column name="type" type="varchar(32)">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableSchemaName="media"
                baseTableName="media_bundles"
                baseColumnNames="owner_user_id"
                referencedTableSchemaName="authentication"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_media_bundles_owner"
                onDelete="SET NULL"/>

        <rollback>
            <dropTable tableName="media_bundles" schemaName="media"/>
        </rollback>
    </changeSet>

    <changeSet id="021-create-media-bundles-indexes" author="Lain (Ivan)">
        <createIndex tableName="media_bundles" schemaName="media" indexName="idx_media_bundles_owner">
            <column name="owner_user_id"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="media_bundles" schemaName="media" indexName="idx_media_bundles_owner"/>
        </rollback>
    </changeSet>

</databaseChangeLog>