<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="030-create-media-bundle-items" author="Lain (Ivan)">
        <createTable tableName="media_bundle_items" schemaName="media">
            <column name="bundle_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="role" type="varchar(32)">
                <constraints nullable="false"/>
            </column>

            <column name="media_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
                schemaName="media"
                tableName="media_bundle_items"
                columnNames="bundle_id, role"
                constraintName="pk_media_bundle_items"/>

        <addForeignKeyConstraint
                baseTableSchemaName="media"
                baseTableName="media_bundle_items"
                baseColumnNames="bundle_id"
                referencedTableSchemaName="media"
                referencedTableName="media_bundles"
                referencedColumnNames="id"
                constraintName="fk_media_bundle_items_bundle"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableSchemaName="media"
                baseTableName="media_bundle_items"
                baseColumnNames="media_id"
                referencedTableSchemaName="media"
                referencedTableName="media_assets"
                referencedColumnNames="id"
                constraintName="fk_media_bundle_items_asset"
                onDelete="RESTRICT"/>

        <rollback>
            <dropTable tableName="media_bundle_items" schemaName="media"/>
        </rollback>
    </changeSet>

    <changeSet id="031-create-media-bundle-items-indexes" author="Lain (Ivan)">
        <createIndex tableName="media_bundle_items" schemaName="media" indexName="idx_media_bundle_items_bundle">
            <column name="bundle_id"/>
        </createIndex>

        <createIndex tableName="media_bundle_items" schemaName="media" indexName="idx_media_bundle_items_media">
            <column name="media_id"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="media_bundle_items" schemaName="media" indexName="idx_media_bundle_items_bundle"/>
            <dropIndex tableName="media_bundle_items" schemaName="media" indexName="idx_media_bundle_items_media"/>
        </rollback>
    </changeSet>

</databaseChangeLog>