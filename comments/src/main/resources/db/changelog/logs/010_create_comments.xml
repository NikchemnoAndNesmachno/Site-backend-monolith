<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="010-create-comments" author="Lain (Ivan)">
        <createTable tableName="comments" schemaName="comments">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="author_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="target_type" type="varchar(64)">
                <constraints nullable="false"/>
            </column>

            <column name="target_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="parent_id" type="BIGINT"/>

            <column name="body" type="varchar(500)">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="varchar(16)" defaultValue="ACTIVE">
                <constraints nullable="false"
                             checkConstraint="status IN ('ACTIVE','DELETED','HIDDEN')"/>
            </column>

            <column name="created_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>

            <column name="deleted_at" type="timestamptz"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableSchemaName="comments"
                baseTableName="comments"
                baseColumnNames="author_user_id"
                referencedTableSchemaName="authentication"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_comments_author_user"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableSchemaName="comments"
                baseTableName="comments"
                baseColumnNames="parent_id"
                referencedTableSchemaName="comments"
                referencedTableName="comments"
                referencedColumnNames="id"
                constraintName="fk_comments_parent"
                onDelete="CASCADE"/>

        <rollback>
            <dropTable schemaName="comments" tableName="comments"/>
        </rollback>
    </changeSet>

    <changeSet id="011-comments-indexes" author="Lain (Ivan)">

        <createIndex schemaName="comments" tableName="comments" indexName="idx_comments_target">
            <column name="target_type"/>
            <column name="target_id"/>
            <column name="created_at"/>
        </createIndex>

        <createIndex schemaName="comments" tableName="comments" indexName="idx_comments_parent">
            <column name="parent_id"/>
            <column name="created_at"/>
        </createIndex>

        <createIndex schemaName="comments" tableName="comments" indexName="idx_comments_author">
            <column name="author_user_id"/>
        </createIndex>

        <rollback>
            <dropIndex schemaName="comments" tableName="comments" indexName="idx_comments_target"/>
            <dropIndex schemaName="comments" tableName="comments" indexName="idx_comments_parent"/>
            <dropIndex schemaName="comments" tableName="comments" indexName="idx_comments_author"/>
        </rollback>
    </changeSet>

</databaseChangeLog>