<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="092-create-comment-closure" author="Lain (Ivan)">
        <createTable tableName="comment_closure" schemaName="comments">
            <column name="ancestor_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="descendant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="depth" type="INT">
                <constraints nullable="false" checkConstraint="depth >= 0"/>
            </column>
        </createTable>

        <addPrimaryKey
                schemaName="comments"
                tableName="comment_closure"
                columnNames="ancestor_id,descendant_id"
                constraintName="pk_comment_closure"/>

        <addForeignKeyConstraint
                baseTableSchemaName="comments"
                baseTableName="comment_closure"
                baseColumnNames="ancestor_id"
                referencedTableSchemaName="comments"
                referencedTableName="comments"
                referencedColumnNames="id"
                constraintName="fk_comment_closure_ancestor"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableSchemaName="comments"
                baseTableName="comment_closure"
                baseColumnNames="descendant_id"
                referencedTableSchemaName="comments"
                referencedTableName="comments"
                referencedColumnNames="id"
                constraintName="fk_comment_closure_descendant"
                onDelete="CASCADE"/>

        <rollback>
            <dropTable schemaName="comments" tableName="comment_closure"/>
        </rollback>
    </changeSet>

    <changeSet id="021-comments-closure-indexes" author="Lain (Ivan)">

        <createIndex schemaName="comments" tableName="comment_closure" indexName="idx_comment_closure_ancestor">
            <column name="ancestor_id"/>
            <column name="depth"/>
            <column name="descendant_id"/>
        </createIndex>

        <createIndex schemaName="comments" tableName="comment_closure" indexName="idx_comment_closure_descendant">
            <column name="descendant_id"/>
            <column name="depth"/>
            <column name="ancestor_id"/>
        </createIndex>

        <rollback>
            <dropIndex schemaName="comments" tableName="comment_closure" indexName="idx_comment_closure_ancestor"/>
            <dropIndex schemaName="comments" tableName="comment_closure" indexName="idx_comment_closure_descendant"/>
        </rollback>
    </changeSet>

</databaseChangeLog>