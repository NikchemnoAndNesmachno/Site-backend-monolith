<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="020-create-credentials" author="Lain (Ivan)">
        <comment>Застосування розширення pgcrypto для створення uuid4 на стороні БД.</comment>

        <createTable tableName="credentials" schemaName="authentication">
            <column name="user_id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="password_hash" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="password_updated_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>

            <column name="failed_login_attempts" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="lock_until" type="timestamptz"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableSchemaName="authentication"
                baseTableName="credentials"
                baseColumnNames="user_id"
                referencedTableSchemaName="authentication"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_credentials_user"
                onDelete="CASCADE"/>

        <rollback>
            <dropTable tableName="credentials" schemaName="authentication"/>
        </rollback>
    </changeSet>


</databaseChangeLog>
