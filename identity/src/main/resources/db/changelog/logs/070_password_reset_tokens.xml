<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="070-create-password-reset-tokens" author="Lain (Ivan)">
        <createTable tableName="password_reset_tokens" schemaName="authentication">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="token_hash" type="varchar(255)">
                <constraints nullable="false"
                             unique="true"/>
            </column>

            <column name="expires_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>

            <column name="used_at" type="timestamptz"/>

            <column name="created_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableSchemaName="authentication"
                baseTableName="password_reset_tokens"
                baseColumnNames="user_id"
                referencedTableSchemaName="authentication"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_password_reset_tokens_user"
                onDelete="CASCADE"/>

        <rollback>
            <dropTable tableName="password_reset_tokens" schemaName="authentication"/>
        </rollback>
    </changeSet>

    <changeSet id="071" author="Lain (Ivan)">
        <createIndex tableName="password_reset_tokens" indexName="idx_password_reset_tokens_user_id" schemaName="authentication">
            <column name="user_id"/>
        </createIndex>

        <createIndex tableName="password_reset_tokens" indexName="idx_password_reset_tokens_expires_at" schemaName="authentication">
            <column name="expires_at"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="password_reset_tokens" indexName="idx_password_reset_tokens_user_id" schemaName="authentication"/>
            <dropIndex tableName="password_reset_tokens" indexName="idx_password_reset_tokens_expires_at" schemaName="authentication"/>
        </rollback>
    </changeSet>

</databaseChangeLog>