<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="001-extensions-pgcrypto" author="Lain (Ivan)">
        <comment>Застосування розширення pgcrypto для створення uuid4 на стороні БД.</comment>

        <sql>CREATE EXTENSION IF NOT EXISTS pgcrypto;</sql>
        <rollback>
            <sql>DROP EXTENSION IF EXISTS pgcrypto;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>